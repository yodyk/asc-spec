# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER expose this to the browser. Used by the sync to write.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Google Sheets (source of truth)
# ─────────────────────────────────────────────────────────────
# The spreadsheet ID (the long string in the sheet URL between /d/ and /edit)
GOOGLE_SHEETS_ID=your-spreadsheet-id
# Service account with read access to the sheet (share the sheet to this email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=asc-sync@your-project.iam.gserviceaccount.com
# The service account private key. Keep the literal \n escapes on one line,
# or paste the multi-line PEM wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────────────────────────────
# Sync
# ─────────────────────────────────────────────────────────────
# Shared secret the /api/sync endpoint requires (Authorization: Bearer <secret>)
# so the public can't trigger it. On Vercel, ALSO set CRON_SECRET to the same
# value — Vercel Cron automatically sends it as the bearer token.
SYNC_SECRET=generate-a-long-random-string
CRON_SECRET=same-as-SYNC_SECRET-for-vercel-cron
# The current published spec version (shown in the UI + stamped on change_log rows).
NEXT_PUBLIC_SPEC_VERSION=1.2
